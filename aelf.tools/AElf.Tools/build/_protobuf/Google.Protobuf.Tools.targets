<?xml version="1.0"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
  </PropertyGroup>

  <!-- Remove protoc-specific properties -->
  <PropertyGroup>
    <Protobuf_Generator Condition=" '$(Protobuf_Generator)' == '' and '$(Language)' == 'C#' ">CSharp</Protobuf_Generator>
    <Protobuf_ProjectSupported Condition=" '$(Protobuf_Generator)' != '' ">true</Protobuf_ProjectSupported>
  </PropertyGroup>

  <!-- Keep only the essential tasks -->
  <UsingTask AssemblyFile="$(_Protobuf_MsBuildAssembly)" TaskName="AElf.Tools.ProtoCompilerOutputs" />
  <UsingTask AssemblyFile="$(_Protobuf_MsBuildAssembly)" TaskName="AElf.Tools.ProtoCompile" />

  <!-- Remove protoc-specific targets -->
  <!-- Keep core compilation target -->
  <Target Name="_Protobuf_CoreCompile"
          Condition=" '$(DisableProtobufDesignTimeBuild)' != 'true' "
          DependsOnTargets="Protobuf_PrepareCompileOptions">
            
    <MakeDir Directories="$(OutputDir)" />

    <ProtoCompile Condition=" '@(Protobuf)' != '' "
      Generator="$(Protobuf_Generator)"
      Protobuf="@(Protobuf)"
      OutputDir="$(OutputDir)"
      OutputOptions="@(OutputOptions)">
      <Output TaskParameter="GeneratedFiles" ItemName="_Protobuf_GeneratedFiles"/>
    </ProtoCompile>
  </Target>

  <!-- Rest of the file remains unchanged -->
</Project>
